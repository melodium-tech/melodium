// Scratch entrypoint for local `location=compose` smoke testing only.
// Exercises unitTests + the x86_64-unknown-linux-gnu build/testers/test flow,
// skipping i686 and aarch64 to fit this machine's resources and architecture.
// Not part of the real pipeline: remove before merging.

use cicd/runners::CicdDispatchEngine
use fs/local::writeLocal
use root/build::buildTarget
use root/test::buildTesters
use root/test::testTarget
use root/test::unitTests
use std/data/string_map::|map
use std/engine/util::startup
use std/flow::waitBlock
use work/resources/arch::|amd64

treatment localSmokeTest(
    const gitlab_token: string,
    const gitlab_project_id: string,
    const gitlab_sha: string,
    const gitlab_ref: string,
    const gitlab_pipeline_id: string,
    const repository_url: string,
    const dispatch_location: string = "compose"
)
  model dispatcher: CicdDispatchEngine(location=dispatch_location)
{
    startup()

    unit: unitTests[cicd=dispatcher](
        repository_url=repository_url,
        ref=gitlab_ref,
        gitlab_token=gitlab_token,
        gitlab_project_id=gitlab_project_id,
        gitlab_sha=gitlab_sha,
        gitlab_pipeline_id=gitlab_pipeline_id
    )
    startup.trigger -> unit.trigger

    build: buildTarget[cicd=dispatcher](
        target="x86_64-unknown-linux-gnu",
        image="rust:1.98-trixie",
        arch=|amd64(),
        cargo_args="--no-default-features --features desktop-edition",
        environment_variables=|map([]),
        pre_commands="apt-get update && apt-get install -y libasound2-dev && ",
        repository_url=repository_url,
        ref=gitlab_ref,
        gitlab_token=gitlab_token,
        gitlab_project_id=gitlab_project_id,
        gitlab_sha=gitlab_sha,
        gitlab_pipeline_id=gitlab_pipeline_id
    )
    write: writeLocal(path="melodium-x86_64-unknown-linux-gnu", create=true)

    testers: buildTesters[cicd=dispatcher](
        target="x86_64-unknown-linux-gnu",
        arch=|amd64(),
        environment_variables=|map([]),
        pre_commands="apt-get update && apt-get install -y libasound2-dev && ",
        repository_url=repository_url,
        ref=gitlab_ref,
        gitlab_token=gitlab_token,
        gitlab_project_id=gitlab_project_id,
        gitlab_sha=gitlab_sha,
        gitlab_pipeline_id=gitlab_pipeline_id
    )

    test: testTarget[cicd=dispatcher](
        target="x86_64-unknown-linux-gnu",
        test_image="debian:trixie",
        arch=|amd64(),
        gitlab_token=gitlab_token,
        gitlab_project_id=gitlab_project_id,
        gitlab_sha=gitlab_sha,
        gitlab_pipeline_id=gitlab_pipeline_id
    )
    awaitTest: waitBlock<void>()

    startup.trigger -> build.trigger
    startup.trigger -> testers.trigger

    build.binary -> write.data
    build.binary -> test.binary
    testers.data -> test.testers

    build.completed   -> awaitTest.a
    testers.completed -> awaitTest.b
    awaitTest.awaited -> test.trigger
}
