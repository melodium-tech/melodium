#!/usr/bin/env melodium
#! name = run_caches_step
#! version = 0.1.0
#! require = std:0.11.0 cicd:0.11.0 crypto:0.11.0 fs:0.11.0 process:0.11.0 work:0.11.0

use std/engine/util::startup
use std/engine/log::logInfoMessage
use std/engine/log::logInfo
use std/flow::close
use std/flow::closeBlock
use std/flow::emit
use std/flow::one
use std/flow::passBlock
use std/flow::stream
use std/flow::trigger
use std/flow/vec::flatten
use std/data/string_map::StringMap
use std/data/string_map/block::entry
use std/text/compose::format
use std/ops/option::|wrap
use std/ops::|equal
use std/ops::|not_equal
use std/ops/option/block::unwrap
use crypto/hash::sha256
use fs/filesystem::FileSystem
use fs/file::read
use fs/local::|local_filesystem
use process/command::Command
use process/command::|command
use process/environment::Environment
use cicd/steps::step

// Runs a step on the local executor, its command building `target` in `directory`, cached
// under `build-` and the sha256 of `directory/lock`: in the volume `data` at `directory`, or
// in the local file system (`local`), the engine running in `directory`. The command notes in
// `seen` whether `target` was restored before it ran, and exits with `exit`.
treatment main(const directory: string, const local: bool = false, const exit: string = "0")
{
    startup()

    emitExecutor: emit<Option<string>>(value=_)
    emitEnvironment: emit<Option<Environment>>(value=_)
    emitCommands: emit<Vec<Command>>(value=[|command("sh", ["-c", "test -f \"$0/target/out\" && echo restored > \"$0/seen\"; mkdir -p \"$0/target\" && echo built > \"$0/target/out\" && exit $1", directory, exit])])
    streamCommands: stream<Vec<Command>>()
    flattenCommands: flatten<Command>()

    step(label="build")
    logSuccess: logInfoMessage(label="step", message="success")
    logFinished: logInfoMessage(label="step", message="finished")

    startup.trigger -> emitExecutor.trigger,emit -> step.executor_name
    startup.trigger -> emitEnvironment.trigger,emit -> step.environment
    startup.trigger -> emitCommands.trigger,emit -> streamCommands.block,stream -> flattenCommands.vector,value -> step.commands

    // The cache: `target` of the volume `data`, or of the local file system.
    onVolume: passBlock<void>(cond=|not_equal<bool>(local, true))
    onLocal: passBlock<void>(cond=|equal<bool>(local, true))
    emitVolume: emit<Option<string>>(value=|wrap<string>("data"))
    emitLocal: emit<Option<string>>(value=_)
    cacheFilesystem: one<Option<string>>()
    emitCachePath: emit<string>(value="target")
    startup.trigger -> onVolume.block,passed -> emitVolume.trigger,emit -> cacheFilesystem.a
    startup.trigger -> onLocal.block,passed -> emitLocal.trigger,emit -> cacheFilesystem.b
    cacheFilesystem.value -> step.cache_filesystem
    startup.trigger -> emitCachePath.trigger,emit -> step.cache_path

    // Its name, computed from the lock file.
    emitLockFilesystem: emit<Option<FileSystem>>(value=|local_filesystem(|wrap<string>(directory)))
    unwrapLockFilesystem: unwrap<FileSystem>()
    emitLockPath: emit<string>(value="lock")
    read()
    sha256()
    digestEntry: entry(key="digest")
    streamName: stream<StringMap>()
    formatName: format(format="build-{digest}")
    name: trigger<string>()
    logName: logInfo(label="name")
    startup.trigger -> emitLockFilesystem.trigger,emit -> unwrapLockFilesystem.option,value -> read.filesystem
    startup.trigger -> emitLockPath.trigger,emit -> read.path
    read.data -> sha256.data,digest -> digestEntry.value,map -> streamName.block,stream -> formatName.entries,formatted -> name.stream,first -> step.cache_name
    name.first -> logName.message

    // No input file, no output file, never terminated.
    closeInFilesystem: closeBlock<string>()
    closeInFile: closeBlock<string>()
    closeData: close<byte>()
    closeTerminate: closeBlock<void>()
    closeOutFilesystem: closeBlock<string>()
    closeOutFile: closeBlock<string>()
    startup.trigger -> closeInFilesystem.trigger,closed -> step.in_filesystem_name
    startup.trigger -> closeInFile.trigger,closed -> step.in_file_name
    startup.trigger -> closeData.trigger,closed -> step.data
    startup.trigger -> closeTerminate.trigger,closed -> step.terminate
    startup.trigger -> closeOutFilesystem.trigger,closed -> step.out_filesystem_name
    startup.trigger -> closeOutFile.trigger,closed -> step.out_file_name
    step.success -> logSuccess.trigger
    step.finished -> logFinished.trigger
}
