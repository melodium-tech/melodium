use std/engine/util::startup
use std/engine/log::logInfos
use std/engine/log::logInfoMessage
use std/engine/log::logErrorMessage
use std/engine/log::logError
use std/engine/log::logErrors
use record/audio::recordMono
use audio/decode::decodeMono
use ml/repos/hf::HfHub
use ml/repos/hf::fetch
use ml/models/whisper::Whisper
use ml/models/whisper::load
use ml/models/whisper::decode
use fs/local::readLocal
use fs/local::writeTextLocal

//
// Speech Transcription — two entrypoints:
//
//  main     : live microphone → Whisper → stdout + file
//             melodium run Compo.toml -- --output transcription.txt
//
//  fromfile : audio file → Whisper → stdout + file
//             melodium run Compo.toml fromfile --input_file speech.wav --output transcription.txt
//

model Hub()    : HfHub   { repo_id = "openai/whisper-tiny" }
model Speech() : Whisper {}

// Live microphone transcription.
treatment main(const output: string = "transcription.txt")
  model hub:     Hub()
  model whisper: Speech()
{
    startup()
    fetch[hub=hub]()
    load[whisper=whisper]()
    decode[whisper=whisper]()

    record:       recordMono(device=_, sample_rate=_)
    log:          logInfos(label="transcription")
    write:        writeTextLocal(path=output, append=true)

    fetchFailed:  logErrorMessage(label="fetch",  message="model fetch failed")
    fetchError:   logError(label="fetch")
    loadFailed:   logErrorMessage(label="load",   message="model load failed")
    loadError:    logError(label="load")
    recFailed:    logErrorMessage(label="record", message="microphone failed")
    recErrors:    logErrors(label="record")
    writeFailed:  logErrorMessage(label="write",  message="write failed")
    writeErrors:  logErrors(label="write")

    startup.trigger    -> fetch.trigger
    fetch.safetensors  -> load.safetensors
    fetch.tokenizer    -> load.tokenizer
    fetch.failed       -> fetchFailed.trigger
    fetch.error        -> fetchError.message
    load.loaded        -> decode.ready
    load.loaded        -> record.trigger
    load.failed        -> loadFailed.trigger
    load.error         -> loadError.message
    record.signal      -> decode.audio
    record.failed      -> recFailed.trigger
    record.errors      -> recErrors.messages
    decode.transcribed --> log.messages
    decode.transcribed --> write.text
    write.failed       -> writeFailed.trigger
    write.errors       -> writeErrors.messages
}

// File transcription.
treatment fromFile(
    const input_file:  string,
    const output:      string = "transcription.txt"
)
  model hub:     Hub()
  model whisper: Speech()
{
    startup()
    fetch[hub=hub]()
    load[whisper=whisper]()
    decode[whisper=whisper]()

    read:         readLocal(path=input_file)
    audioDecode:  decodeMono(hint="wav")
    log:          logInfos(label="transcription")
    write:        writeTextLocal(path=output, append=false)

    fetchFailed:  logErrorMessage(label="fetch",   message="model fetch failed")
    fetchError:   logError(label="fetch")
    loadFailed:   logErrorMessage(label="load",    message="model load failed")
    loadError:    logError(label="load")
    readFailed:   logErrorMessage(label="read",    message="file read failed")
    readErrors:   logErrors(label="read")
    audFailed:    logErrorMessage(label="decode",  message="audio decode failed")
    audErrors:    logErrors(label="decode")
    writeFailed:  logErrorMessage(label="write",   message="write failed")
    writeErrors:  logErrors(label="write")

    startup.trigger    -> fetch.trigger
    fetch.safetensors  -> load.safetensors
    fetch.tokenizer    -> load.tokenizer
    fetch.failed       -> fetchFailed.trigger
    fetch.error        -> fetchError.message
    load.loaded        -> decode.ready
    load.loaded        -> read.trigger
    load.failed        -> loadFailed.trigger
    load.error         -> loadError.message
    read.data          -> audioDecode.data
    read.failed        -> readFailed.trigger
    read.errors        -> readErrors.messages
    audioDecode.signal -> decode.audio
    audioDecode.failed -> audFailed.trigger
    audioDecode.errors -> audErrors.messages
    decode.transcribed --> log.messages
    decode.transcribed --> write.text
    write.failed       -> writeFailed.trigger
    write.errors       -> writeErrors.messages
}
