    Self.trigger -> testersX86_64AppleDarwin.trigger
    buildX86_64AppleDarwin.binary -> package.x86_64_apple_darwin

    // -- aarch64-apple-darwin, tested on GitLab --

    checkAarch64AppleDarwin: checkTarget[cicd=cicd](gitlab_token=gitlab_token, target="aarch64-apple-darwin", arch=|amd64(), setup=setup_aarch64_apple_darwin, desktop=true, repository_url=repository_url, ref=ref, gitlab_project_id=gitlab_project_id, gitlab_sha=gitlab_sha, gitlab_pipeline_id=gitlab_pipeline_id)
