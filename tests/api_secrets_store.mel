#!/usr/bin/env melodium
#! name = api_secrets_store
#! version = 0.1.0
#! require = std:0.11.0 crypto:0.11.0 work:0.11.0

use std/engine/util::startup
use std/engine/log::logInfoMessage
use std/engine/log::logError
use std/flow::emit
use crypto/random::token
use work/secret::store
use work/secret::storeBytes

// Generates a password and stores it on Cadence.CI, with a key, for later runs.
treatment main(
    const name: string = "generated/db-password",
    const key: Secret<Vec<byte>> = "env:MELODIUM_SECRET_STORE_KEY"
)
{
    startup()

    generate: token(name="db_password")
    storePassword: store(name=name)
    logStored: logInfoMessage(label="store", message="password stored")
    logGenerateError: logError(label="generate")
    logStoreError: logError(label="store")
    startup.trigger -> generate.trigger,token -> storePassword.secret
    generate.error -> logGenerateError.message
    storePassword.completed -> logStored.trigger
    storePassword.error -> logStoreError.message

    emitKey: emit<Secret<Vec<byte>>>(value=key)
    storeKey: storeBytes(name="generated/key")
    logKeyStored: logInfoMessage(label="store", message="key stored")
    logKeyError: logError(label="store-key")
    startup.trigger -> emitKey.trigger,emit -> storeKey.secret
    storeKey.completed -> logKeyStored.trigger
    storeKey.error -> logKeyError.message
}
