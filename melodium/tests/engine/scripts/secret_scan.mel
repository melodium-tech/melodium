#!/usr/bin/env melodium
#! name = secret_scan
#! version = 0.11.0
#! require = std:0.11.0

use std/engine/util::startup
use std/engine/log::logError
use std/flow::emit
use std/flow::stream
use std/flow::check
use std/flow::consume
use std/flow/vec::flatten
use std/text/convert/string::toUtf8
use std/secret::conceal
use std/secret::reveal
use std/secret::scan

treatment main()
{
    startup()

    // The value is revealed first, then searched in data.
    emitValue: emit<string>(value="scan-test-secret-value")
    concealValue: conceal<string>(name="scanned", plain_reveal=true)
    revealValue: reveal<string>()
    revealed: check<string>()

    startup.trigger -> emitValue.trigger,emit -> concealValue.value,secret -> revealValue.secret,value -> revealed.value

    emitClean: emit<Vec<string>>(value=["clean data, ", "nothing revealed"])
    streamClean: stream<Vec<string>>()
    flattenClean: flatten<string>()
    utf8Clean: toUtf8()
    clean: scan()

    revealed.check -> emitClean.trigger,emit -> streamClean.block,stream -> flattenClean.vector,value -> utf8Clean.text,encoded -> clean.data

    // The value is split across two chunks, after enough data for some to be given.
    emitLeaking: emit<Vec<string>>(value=["012345678901234567890123456789012345678901234567890123456789scan-test-se", "cret-value after"])
    streamLeaking: stream<Vec<string>>()
    flattenLeaking: flatten<string>()
    utf8Leaking: toUtf8()
    leaking: scan()
    logLeak: logError(label="leak")

    revealed.check -> emitLeaking.trigger,emit -> streamLeaking.block,stream -> flattenLeaking.vector,value -> utf8Leaking.text,encoded -> leaking.data
    leaking.error -> logLeak.message

    // Outputs are connected, so that what they send is in debug events.
    consumeClean: consume<byte>()
    consumeLeaking: consume<byte>()
    clean.scanned ---> consumeClean.stream
    leaking.scanned -> consumeLeaking.stream
    cleanCompleted: check<void>()
    cleanFailed: check<void>()
    leakingCompleted: check<void>()
    leakingFailed: check<void>()
    clean.completed ---> cleanCompleted.value
    clean.failed ------> cleanFailed.value
    leaking.completed -> leakingCompleted.value
    leaking.failed ----> leakingFailed.value
}
