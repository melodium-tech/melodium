#!/usr/bin/env melodium
#! name = api_secrets_reserved
#! version = 0.1.0
#! require = std:0.11.0 vault:0.11.0

use std/engine/util::startup
use vault::Vault

// `api` is reserved for the secrets of Cadence.CI: the launch fails.
treatment main()
  model vault: Vault(address="http://127.0.0.1:8200", source="api")
{
    startup()
}
