    checkI686PcWindowsGnu: checkTarget[cicd=cicd](gitlab_token=gitlab_token, target="i686-pc-windows-gnu", arch=|amd64(), setup=setup_i686_pc_windows_gnu, desktop=true, repository_url=repository_url, ref=ref, gitlab_project_id=gitlab_project_id, gitlab_sha=gitlab_sha, gitlab_pipeline_id=gitlab_pipeline_id)
