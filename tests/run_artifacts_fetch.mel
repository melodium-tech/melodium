#!/usr/bin/env melodium
#! name = run_artifacts_fetch
#! version = 0.1.0
#! require = std:0.11.0 fs:0.11.0 work:0.11.0

use std/engine/util::startup
use std/engine/log::logInfoMessage
use std/engine/log::logError
use std/flow::emit
use work/resources::getFileSystem
use work/artifact::fetchArtifact

// Fetches the artifact `name` of the run `run` into `path` of the volume `data`.
treatment main(const run: string, const name: string, const path: string = "fetched")
{
    startup()

    emitVolume: emit<string>(value="data")
    getFileSystem()
    emitPath: emit<string>(value=path)
    emitRun: emit<string>(value=run)
    emitName: emit<string>(value=name)
    fetchArtifact()
    logFetched: logInfoMessage(label="artifact", message="fetched")
    logNotFetched: logInfoMessage(label="artifact", message="not fetched")
    logFetchError: logError(label="artifact")

    startup.trigger -> emitVolume.trigger,emit -> getFileSystem.name,filesystem -> fetchArtifact.filesystem
    startup.trigger -> emitPath.trigger,emit -> fetchArtifact.path
    startup.trigger -> emitRun.trigger,emit -> fetchArtifact.run
    startup.trigger -> emitName.trigger,emit -> fetchArtifact.name
    fetchArtifact.completed -> logFetched.trigger
    fetchArtifact.failed ----> logNotFetched.trigger
    fetchArtifact.error -----> logFetchError.message
}
