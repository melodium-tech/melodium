use std/engine/util::startup
use std/engine/log::logInfoMessage
use std/engine/log::logErrorMessage
use std/flow::one
use std/flow::flock
use std/flow::trigger
use std/data/string_map::StringMap
use std/data/string_map::|map
use std/data/string_map::|entry
use std/ops/option::|wrap
use process/command::|raw_commands
use work/resources/arch::|amd64
use work/resources::|service_container
use cicd/runners::CicdDispatchEngine
use cicd/naive::simpleStep
use cicd/naive::simpleStepWithInput
use fs/local::writeLocal

//
// CI Pipeline
//
// A three-stage CI pipeline that runs entirely on provisioned cloud containers:
//
//   Stage 1 — build    : rust:1.82-slim container; `cargo build --release`
//                        produces a compiled binary streamed back locally.
//
//   Stage 2 — test     : rust:1.82-slim + postgres:16 service container;
//                        `cargo test`; exercises integration tests that need
//                        a live database (DATABASE_URL is wired to the sidecar).
//
//   Stage 3 — package  : debian:bookworm-slim container; bundles the binary
//                        into a tar.gz archive and streams the archive back.
//
// Stages 1 and 2 run concurrently.  Stage 3 starts only after both succeed.
// The binary produced by stage 1 is piped directly into stage 3 as input data.
//
// Usage:
//   melodium run Compo.toml -- \
//     --api_token "my-api-token" \
//     --repo_url  "https://github.com/my-org/my-project.git"
//

model Dispatcher(const api_token: string) : CicdDispatchEngine {
    api_token = |wrap<string>(api_token)
}

treatment main(
    const api_token: string,
    const repo_url:  string,
    const output:    string = "artifact.tar.gz"
)
  model dispatcher: Dispatcher(api_token=api_token)
{
    startup()
    logStart: logInfoMessage(label="ci", message="pipeline started")
    startup.trigger -> logStart.trigger

    // Stage 1: build — compile release binary in a Rust container.
    build[dispatcher=dispatcher](repo_url=repo_url)
    startup.trigger -> build.trigger

    buildFailed: logErrorMessage(label="build", message="build stage failed")
    buildError:  logErrorMessage(label="build", message="build stage exited with error")
    build.failed -> buildFailed.trigger
    build.error  -> buildError.trigger

    logBuildOk: logInfoMessage(label="build", message="build succeeded")
    build.success -> logBuildOk.trigger

    // Stage 2: test — run cargo test with a Postgres sidecar.
    test[dispatcher=dispatcher](repo_url=repo_url)
    startup.trigger -> test.trigger

    testFailed: logErrorMessage(label="test", message="test stage failed")
    testError:  logErrorMessage(label="test", message="tests did not pass")
    test.failed -> testFailed.trigger
    test.error  -> testError.trigger

    logTestOk: logInfoMessage(label="test", message="all tests passed")
    test.success -> logTestOk.trigger

    // Abort logging: fire if any stage fails or errors (chain two one<void> for 4 signals).
    failedOrError1: one<void>()
    failedOrError2: one<void>()
    build.failed -> failedOrError1.a
    test.failed  -> failedOrError1.b
    build.error  -> failedOrError2.a
    test.error   -> failedOrError2.b

    oneAnyFailed: one<void>()
    failedOrError1.value -> oneAnyFailed.a
    failedOrError2.value -> oneAnyFailed.b

    logAbort: logErrorMessage(label="ci", message="pipeline aborted — skipping package stage")
    oneAnyFailed.value -> logAbort.trigger

    // Wait for both stages to finish before packaging.
    bothFinished: flock<void>()
    build.finished -> bothFinished.a
    test.finished  -> bothFinished.b

    // flock.stream is Stream<void>; convert to Block<void> trigger for package.
    bothTrigger: trigger<void>()
    bothFinished.stream -> bothTrigger.stream

    // Stage 3: package — receives the binary from stage 1, bundles it into a tar.gz.
    package[dispatcher=dispatcher](output=output)
    bothTrigger.start -> package.trigger
    build.data        -> package.data

    packageFailed: logErrorMessage(label="package", message="package stage failed")
    packageError:  logErrorMessage(label="package", message="package stage exited with error")
    package.failed -> packageFailed.trigger
    package.error  -> packageError.trigger

    // Write the final archive locally.
    write: writeLocal(path=output)
    package.data -> write.data

    logDone:     logInfoMessage(label="ci", message="pipeline complete — artifact written")
    writeFailed: logErrorMessage(label="write", message="write failed")
    write.completed -> logDone.trigger
    write.failed    -> writeFailed.trigger
}

// Stage 1: clone the repo and compile a release binary in a Rust container.
// The binary is streamed back via `data` (read from /mnt/data/binary on the container).
treatment build[dispatcher: CicdDispatchEngine](const repo_url: string)
  input  trigger:  Block<void>
  output started:  Block<void>
  output success:  Block<void>
  output error:    Block<void>
  output failed:   Block<void>
  output finished: Block<void>
  output data:     Stream<byte>
{
    simpleStep[dispatcher=dispatcher](
        name         = "build",
        image        = "rust:1.82-slim",
        cpu          = 2000,
        memory       = 4096,
        storage      = 8192,
        max_duration = 1800,
        commands     = |raw_commands([
            "apt-get update -qq && apt-get install -y --no-install-recommends git",
            "git clone --depth 1 ${REPO_URL} /workspace",
            "cd /workspace && cargo build --release 2>&1",
            "cp /workspace/target/release/app /mnt/data/binary"
        ]),
        variables    = |wrap<StringMap>(|map([|entry<string>("REPO_URL", repo_url)])),
        out_file     = "binary"
    )

    Self.trigger -> simpleStep.trigger
    simpleStep.started  -> Self.started
    simpleStep.success  -> Self.success
    simpleStep.error    -> Self.error
    simpleStep.failed   -> Self.failed
    simpleStep.finished -> Self.finished
    simpleStep.data     -> Self.data
}

// Stage 2: clone the repo and run `cargo test` with a Postgres service container.
// DATABASE_URL is set to point at the postgres sidecar.
treatment test[dispatcher: CicdDispatchEngine](const repo_url: string)
  input  trigger:  Block<void>
  output started:  Block<void>
  output success:  Block<void>
  output error:    Block<void>
  output failed:   Block<void>
  output finished: Block<void>
{
    simpleStep[dispatcher=dispatcher](
        name         = "test",
        image        = "rust:1.82-slim",
        cpu          = 2000,
        memory       = 4096,
        storage      = 8192,
        max_duration = 1800,
        service_containers = [
            |service_container(
                "postgres",
                512,
                1000,
                2048,
                |amd64(),
                [],
                "postgres:16",
                _,
                |wrap<StringMap>(|map([
                    |entry<string>("POSTGRES_USER",     "ci"),
                    |entry<string>("POSTGRES_PASSWORD", "ci"),
                    |entry<string>("POSTGRES_DB",       "ci_test")
                ])),
                _
            )
        ],
        commands     = |raw_commands([
            "apt-get update -qq && apt-get install -y --no-install-recommends git",
            "git clone --depth 1 ${REPO_URL} /workspace",
            "cd /workspace && cargo test 2>&1"
        ]),
        variables    = |wrap<StringMap>(|map([
            |entry<string>("REPO_URL",     repo_url),
            |entry<string>("DATABASE_URL", "postgres://ci:ci@postgres/ci_test")
        ]))
    )

    Self.trigger -> simpleStep.trigger
    simpleStep.started  -> Self.started
    simpleStep.success  -> Self.success
    simpleStep.error    -> Self.error
    simpleStep.failed   -> Self.failed
    simpleStep.finished -> Self.finished
}

// Stage 3: receives the compiled binary as input bytes; bundles it into a tar.gz.
// The archive is streamed back via `data`.
treatment package[dispatcher: CicdDispatchEngine](const output: string)
  input  trigger:  Block<void>
  input  data:     Stream<byte>
  output started:  Block<void>
  output success:  Block<void>
  output error:    Block<void>
  output failed:   Block<void>
  output finished: Block<void>
  output data:     Stream<byte>
{
    simpleStepWithInput[dispatcher=dispatcher](
        name         = "package",
        image        = "debian:bookworm-slim",
        cpu          = 500,
        memory       = 512,
        storage      = 2048,
        max_duration = 300,
        in_file      = "binary",
        commands     = |raw_commands([
            "chmod +x /mnt/data/binary",
            "tar -czf /mnt/data/artifact.tar.gz -C /mnt/data binary"
        ]),
        out_file     = "artifact.tar.gz"
    )

    Self.trigger -> simpleStepWithInput.trigger
    Self.data    -> simpleStepWithInput.data
    simpleStepWithInput.started  -> Self.started
    simpleStepWithInput.success  -> Self.success
    simpleStepWithInput.error    -> Self.error
    simpleStepWithInput.failed   -> Self.failed
    simpleStepWithInput.finished -> Self.finished
    simpleStepWithInput.data     -> Self.data
}
