use cicd/runners::CicdDispatchEngine
use cicd/runners::CicdRunnerEngine
use cicd/runners::setupRunner
use cicd/runners::stopRunner
use cicd/services::setServiceState
use cicd/steps::stepOn
use cicd/steps::stepOnWithInput
use process/command::|command
use process/environment::Environment
use process/environment::|environment
use regex::|replace
use root/source::sourceStep
use std/data/string_map::StringMap
use std/data/string_map::|entry
use std/data/string_map::|map
use std/flow::closeBlock
use std/flow::one
use std/ops/option::|unwrap_or
use std/ops/option::|wrap
use std/text/compose::|format
use work/resources::|container
use work/resources::|mount
use work/resources::|service_container
use work/resources::|volume
use work/resources/arch::Arch
use work/resources/arch::|amd64

/**
  Runs the Rust tests of the workspace.
*/
treatment unitTests[cicd: CicdDispatchEngine](
    const gitlab_token: Secret<string>,
    var repository_url: string,
    var ref: string,
    var gitlab_project_id: string,
    var gitlab_sha: string,
    var gitlab_pipeline_id: string
)
  input trigger: Block<void>
  output completed: Block<void>
  output failed: Block<void>
{
    unitTest: sourceStep[cicd=cicd](
        gitlab_token=gitlab_token,
        name="unit-tests",
        description="Rust unit tests",
        arch=|wrap<Arch>(|amd64()),
        storage=50000,
        // Full debug information makes each test binary hundreds of megabytes, filling the
        // disk (the linker then fails with a bus error). Line numbers are kept.
        variables=|wrap<StringMap>(|map([|entry("CARGO_PROFILE_DEV_DEBUG", "line-tables-only")])),
        setup=${{apt-get update
apt-get install -y libasound2-dev}},
        script="cargo test --locked --verbose",
        repository_url=repository_url,
        ref=ref,
        gitlab_project_id=gitlab_project_id,
        gitlab_sha=gitlab_sha,
        gitlab_pipeline_id=gitlab_pipeline_id
    )

    Self.trigger -> unitTest.trigger
    unitTest.completed -> Self.completed
    unitTest.failed ----> Self.failed
}

/**
  Builds the testers for `target` and gives them, with the `.mel` files of `tests`, flattened in `testers.tar.gz`.

  `cargo_args` and `profile_directory` select the profile, `--release` and `release` for the Windows targets.
  Debug information is reduced to line numbers, as the testers go through the engine running the pipeline.
*/
treatment buildTesters[cicd: CicdDispatchEngine](
    const gitlab_token: Secret<string>,
    var target: string,
    var arch: Arch,
    var setup: string,
    var cargo_args: string = "",
    var profile_directory: string = "debug",
    var repository_url: string,
    var ref: string,
    var gitlab_project_id: string,
    var gitlab_sha: string,
    var gitlab_pipeline_id: string
)
  input trigger: Block<void>
  output data: Stream<byte>
  output completed: Block<void>
  output failed: Block<void>
{
    testers: sourceStep[cicd=cicd](
        gitlab_token=gitlab_token,
        name=|format("testers-{target}", |entry("target", target)),
        description=|format("Build testers for {target}", |entry("target", target)),
        arch=|wrap<Arch>(arch),
        variables=|wrap<StringMap>(|map([|entry("CARGO_PROFILE_DEV_DEBUG", "line-tables-only")])),
        setup=setup,
        script=|format(
            ${{cd tests/testers
cargo build --locked --target {target} {cargo_args}
for f in ../*.mel
do
  tar --append --transform 's,.*/,,' --file testers.tar "$f"
done
for f in target/{target}/{profile_directory}/*
do
  case "$f" in
    *.exe) tar --append --transform 's,.*/,,' --file testers.tar "$f" ;;
    *) if [ -f "$f" ] && [ -x "$f" ]; then tar --append --transform 's,.*/,,' --file testers.tar "$f"; fi ;;
  esac
done
gzip testers.tar
mv testers.tar.gz /mnt/data/testers.tar.gz}},
            |map([
                |entry("target", target),
                |entry("cargo_args", cargo_args),
                |entry("profile_directory", profile_directory)
            ])
        ),
        out_file=|wrap<string>("testers.tar.gz"),
        repository_url=repository_url,
        ref=ref,
        gitlab_project_id=gitlab_project_id,
        gitlab_sha=gitlab_sha,
        gitlab_pipeline_id=gitlab_pipeline_id
    )

    Self.trigger -> testers.trigger,data -> Self.data
    testers.completed -> Self.completed
    testers.failed ----> Self.failed
}

/**
  Runs the testers received through `testers` against the `melodium` executable received through `binary`, on `test_image` with a PostgreSQL service.

  `install_script` prepares `test_image` (shell lines run with `set -ex`), the default one is for Debian.
*/
treatment testTarget[cicd: CicdDispatchEngine](
    const gitlab_token: Secret<string>,
    var target: string,
    var test_image: string = "debian:trixie",
    var arch: Arch,
    var install_script: string = ${{apt-get update
apt-get install -y ca-certificates libasound2}},
    var ref: string,
    var gitlab_project_id: string,
    var gitlab_sha: string,
    var gitlab_pipeline_id: string
)
  model runner: CicdRunnerEngine()
  input trigger: Block<void>
  input binary: Stream<byte>
  input testers: Stream<byte>
  output completed: Block<void>
  output failed: Block<void>
{
    report: setServiceState(
        name=|format("test-{target}", |entry("target", target)),
        report=true,
        gitlab=true,
        gitlab_token=gitlab_token,
        gitlab_project_id=gitlab_project_id,
        gitlab_sha=gitlab_sha,
        gitlab_ref=ref,
        gitlab_pipeline_id=gitlab_pipeline_id,
        log_response=true,
        description=|format("Run tests on {target}", |entry("target", target))
    )
    noCancel: closeBlock<void>()

    setupRunner[dispatcher=cicd, runner=runner](
        // Hostname-safe name, see `sourceStep`.
        name=|format("test-{target}", |entry("target", |unwrap_or<string>(|replace(target, "_", "-"), target))),
        // Storage of the worker must exceed its volumes.
        cpu=200, memory=200, storage=3500,
        arch=|wrap<Arch>(arch),
        tags=[|format("name=test-{target}", |entry("target", target))],
        volumes=[|volume("binaries", 3000)],
        containers=[
            |container("test", 1000, 1000, 4000, |wrap<Arch>(arch), [|mount("binaries", "/mounted/binaries")], test_image, _)
        ],
        service_containers=[
            |service_container("postgres", 4000, 1000, 10000, |wrap<Arch>(arch), [], "postgres:16", _, |wrap<StringMap>(|map([
                |entry("POSTGRES_DB", "test_db"),
                |entry("POSTGRES_USER", "test_user"),
                |entry("POSTGRES_PASSWORD", "test_pAs$w0rD"),
                |entry("POSTGRES_HOST_AUTH_METHOD", "trust")
            ])), _)
        ]
    )

    installBinary: stepOnWithInput[runner=runner](
        name="install-melodium",
        executor_name=|wrap<string>("test"),
        in_filesystem=|wrap<string>("binaries"),
        in_file=|wrap<string>("melodium"),
        commands=[
            |command("sh", ["-c", |format(
                ${{set -ex
{install_script}
mv /mounted/binaries/melodium /usr/local/bin/melodium
chmod +x /usr/local/bin/melodium}},
                |map([|entry("install_script", install_script)])
            )])
        ]
    )

    installTesters: stepOnWithInput[runner=runner](
        name="install-testers",
        executor_name=|wrap<string>("test"),
        in_filesystem=|wrap<string>("binaries"),
        in_file=|wrap<string>("testers.tar.gz"),
        environment=|wrap<Environment>(|environment(|map([]), |wrap<string>("/mounted/binaries"), false, false)),
        commands=[
            |command("sh", ["-c", "set -x; tar -x -z -f /mounted/binaries/testers.tar.gz"])
        ]
    )

    runTests: stepOn[runner=runner](
        name="run-tests",
        executor_name=|wrap<string>("test"),
        environment=|wrap<Environment>(|environment(|map([
            |entry("POSTGRES_DB", "test_db"),
            |entry("POSTGRES_USER", "test_user"),
            |entry("POSTGRES_PASSWORD", "test_pAs$w0rD"),
            |entry("POSTGRES_HOST", "postgres"),
            |entry("POSTGRES_HOST_AUTH_METHOD", "trust")
        ]), |wrap<string>("/mounted/binaries"), false, false)),
        // Run every test regardless of individual failures, tracking overall status in $OK
        // (matching the legacy GitLab job's loop); `set -x` echoes each `./name` as it runs.
        commands=[
            |command("sh", ["-c", ${{set -x
OK=0
for t in check_rejections complex_call fs generics http_client http_javascript interruption process regex sql http_distributed process_distributed process_distributed_hang process_distributed_slow process_distributed_logs_live distribution_engine_never_started distribution_engine_stop_without_start logs_live_flush stop_before_data_drained protocol_timeout_survives_jitter crypto_webhooks dist_keys http_secrets interruption_signals new_templates process_secrets secret_access_cli secret_distribution secret_leaks secret_masking signed_webhooks wipe work_secrets; do
  ./$t || OK=1
done
exit $OK}}])
        ]
    )

    stopRunner[runner=runner]()

    installFailure: one<void>()
    installBinary.error  -> installFailure.a
    installBinary.failed -> installFailure.b

    installTestersFailure: one<void>()
    installTesters.error  -> installTestersFailure.a
    installTesters.failed -> installTestersFailure.b

    runFailure: one<void>()
    runTests.error  -> runFailure.a
    runTests.failed -> runFailure.b

    setupOrInstallFailure: one<void>()
    setupRunner.failed   -> setupOrInstallFailure.a
    installFailure.value -> setupOrInstallFailure.b

    installOrRunFailure: one<void>()
    installTestersFailure.value -> installOrRunFailure.a
    runFailure.value            -> installOrRunFailure.b

    testFailure: one<void>()
    setupOrInstallFailure.value -> testFailure.a
    installOrRunFailure.value   -> testFailure.b

    Self.binary  -> installBinary.data
    Self.testers -> installTesters.data

    Self.trigger -> setupRunner.trigger,ready -> installBinary.trigger,completed -> installTesters.trigger,completed -> runTests.trigger,finished -> stopRunner.trigger
    runTests.success   -> Self.completed
    testFailure.value  -> Self.failed

    Self.trigger       -> report.pending
    setupRunner.ready  -> report.running
    runTests.success   -> report.success
    runTests.error     -> report.error
    testFailure.value  -> report.failed
    Self.trigger       -> noCancel.trigger,closed -> report.canceled
}
