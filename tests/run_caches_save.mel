#!/usr/bin/env melodium
#! name = run_caches_save
#! version = 0.1.0
#! require = std:0.11.0 work:0.11.0

use std/engine/util::startup
use std/engine/log::logInfoMessage
use std/engine/log::logError
use std/flow::emit
use work/cache::save

// Saves `path` of the volume `data` as the cache `key`.
treatment main(const key: string, const path: string = "target")
{
    startup()

    emitKey: emit<string>(value=key)
    saveCache: save(volume="data", path=path)
    logSaved: logInfoMessage(label="cache", message="saved")
    logSaveError: logError(label="cache")

    startup.trigger -> emitKey.trigger,emit -> saveCache.key
    saveCache.completed -> logSaved.trigger
    saveCache.error -> logSaveError.message
}
