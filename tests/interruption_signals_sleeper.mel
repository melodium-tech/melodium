#!/usr/bin/env melodium
#! name = sleeper
#! version = 0.11.1
#! require = std:0.11.1 process:0.11.1

use std/engine/util::startup
use process/command::|command
use process/local::execOnce

// Runs `sleep <duration>` as child process, the duration identifying it.
treatment main(const duration: string)
{
    startup()
    sleep: execOnce(command=|command("sleep", [duration]))

    startup.trigger -> sleep.launch
}
