#!/usr/bin/env melodium
#! name = run_caches_leak
#! version = 0.1.0
#! require = std:0.11.0 process:0.11.0 work:0.11.0

use std/engine/util::startup
use std/engine/log::logInfoMessage
use std/engine/log::logError
use std/flow::emit
use std/data/map::|map as |secret_map
use std/data/map::|entry as |secret_entry
use std/data/string_map::|map
use std/ops/option::|wrap
use process/command::|command
use process/environment::Environment
use process/environment::|environment
use process/environment::|with_secret_variables
use process/local::execOnce
use work/cache::save

// A command gets the password as a variable and writes it in `directory`, which is then
// saved as a cache.
treatment main(
    const key: string,
    const directory: string,
    const password: Secret<string> = "env:MELODIUM_SECRET_CACHE_PASSWORD"
)
{
    startup()

    run: execOnce(
        command=|command("sh", ["-c", "printf 'password=%s\n' \"$PASSWORD\" > \"$0/config\"", directory]),
        environment=|wrap<Environment>(|with_secret_variables(
            |environment(|map([]), _, false, false),
            |secret_map([|secret_entry<Secret<string>>("PASSWORD", password)])
        ))
    )
    logRunError: logError(label="exec")
    startup.trigger -> run.launch
    run.error -> logRunError.message

    emitKey: emit<string>(value=key)
    saveCache: save(volume="data", path="target")
    logSaved: logInfoMessage(label="cache", message="saved")
    logSaveError: logError(label="cache")

    run.completed -> emitKey.trigger,emit -> saveCache.key
    saveCache.completed -> logSaved.trigger
    saveCache.error -> logSaveError.message
}
