#!/usr/bin/env melodium
#! name = secret_vault_duplicate
#! version = 0.10.4
#! require = std:0.10.4 vault:0.10.4

use std/engine/util::startup
use vault::Vault

treatment main()
  model first: Vault(address = "http://127.0.0.1:1")
  model second: Vault(address = "http://127.0.0.1:2")
{
    startup()
}
