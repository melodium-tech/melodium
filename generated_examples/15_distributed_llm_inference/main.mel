use std/engine/util::startup
use std/engine/log::logInfoMessage
use std/engine/log::logErrorMessage
use std/engine/log::logError
use std/engine/log::logErrors
use std/flow::emit
use std/flow::trigger
use std/data/string_map::StringMap
use std/data/string_map::|map as |string_map
use std/data/map::|map
use std/data/map::|entry
use std/ops/option::|wrap
use http/server::HttpServer
use http/server::start as startHttp
use http/server::connection
use http/method::|post
use http/status::|ok
use http/status::HttpStatus
use net/ip::|localhost_ipv4
use net/ip::|from_ipv4
use encoding::decode
use encoding::encode
use ml/remote/llm::RemoteLlm
use ml/remote/llm::chat
use work/distant::DistantEngine
use work/distant::distant
use distrib::DistributionEngine
use distrib::start
use distrib::distribute
use distrib::sendStream
use distrib::recvStream

//
// Distributed LLM Inference
//
// An HTTP server that accepts POST /chat with a plain-text prompt body and
// streams the LLM response back to the caller.  The LLM call runs on a
// Mélodium cloud runner provisioned on demand — the `ml` package only needs
// to be available on the runner, not on the front-end machine.
//
// Usage:
//   melodium run Compo.toml -- \
//     --api_token   "my-api-token" \
//     --openai_key  sk-... \
//     --port 8080
//
// Test with:
//   curl -X POST http://127.0.0.1:8080/chat \
//        -H "Content-Type: text/plain" \
//        -d "Explain the Mélodium dataflow model in one sentence."
//

// LLM model used by the remote runner.
model Assistant(const openai_key: string) : RemoteLlm {
    backend    = "openai"
    api_key    = openai_key
    model      = "gpt-4o-mini"
    system     = "You are a concise and helpful assistant."
    max_tokens = 1024
}

treatment server(
    const api_token:  string,
    const openai_key: string,
    const port:       u16 = 8080
)
  model runner: DistantEngine(api_url=|wrap<string>("https://api.melodium.tech/0.1"), api_token=|wrap<string>(api_token))
  model distributor: DistributionEngine(
    treatment = "distributed_llm_inference/main::inferText",
    version   = "0.1.0"
  )
  model httpServer: HttpServer(host=|from_ipv4(|localhost_ipv4()), port=port)
{
    startup()
    logStart: logInfoMessage(label="cloud", message="provisioning LLM runner…")
    startup.trigger -> logStart.trigger

    provisionRunner: distant[distant_engine=runner](
        max_duration = 600,
        memory       = 512,
        cpu          = 1000,
        storage      = 512,
        edition      = _,
        arch         = _,
        volumes      = [],
        containers   = [],
        service_containers = [],
        tags         = []
    )
    startup.trigger -> provisionRunner.trigger,access -> distribStart.access

    distantErrLog:  logErrors(label="distant")
    distantFailLog: logErrorMessage(label="distant", message="runner provisioning failed")
    provisionRunner.errors -> distantErrLog.messages
    provisionRunner.failed -> distantFailLog.trigger

    distribStart: start[distributor=distributor](params=|map([|entry<string>("openai_key", openai_key)]))

    distribErr:    logError(label="distrib")
    distribFailed: logErrorMessage(label="distrib", message="distribution engine failed")
    distribStart.error  -> distribErr.message
    distribStart.failed -> distribFailed.trigger

    logReady: logInfoMessage(label="distrib", message="LLM runner connected")
    distribStart.ready -> logReady.trigger

    startHttp[http_server=httpServer]()
    logServerReady: logInfoMessage(label="server", message="HTTP server ready")
    distribStart.ready -> startHttp.trigger
    distribStart.ready -> logServerReady.trigger

    connection[http_server=httpServer](method=|post(), route="/chat")

    status:      emit<HttpStatus>(value=|ok())
    headers:     emit<StringMap>(value=|string_map([]))
    bodyTrigger: trigger<byte>()

    connection.data -> bodyTrigger.stream,start --> status.trigger,emit  -> connection.status
                       bodyTrigger.start --------> headers.trigger,emit -> connection.headers

    dispatchInfer[distributor=distributor]()
    connection.data -> dispatchInfer.prompt,response -> connection.data
}

// Sends the prompt bytes to the remote inferText treatment and streams the response back.
treatment dispatchInfer[distributor: DistributionEngine]()
  input  prompt:   Stream<byte>
  output response: Stream<byte>
{
    trig: trigger<byte>()
    dist: distribute[distributor=distributor]()

    Self.prompt -> trig.stream,start -> dist.trigger

    sendPrompt:   sendStream<byte>[distributor=distributor](name="prompt")
    recvResponse: recvStream<byte>[distributor=distributor](name="response")

    dist.distribution_id -> sendPrompt.distribution_id
    dist.distribution_id -> recvResponse.distribution_id

    Self.prompt       -> sendPrompt.data
    recvResponse.data -> Self.response
}

// The treatment executed remotely for each chat request.
// Receives raw UTF-8 prompt bytes, calls the LLM, streams response bytes back.
treatment inferText(const openai_key: string)
  model llm: Assistant(openai_key=openai_key)
  input  prompt:   Stream<byte>
  output response: Stream<byte>
{
    decodePrompt: decode()
    Self.prompt -> decodePrompt.data,text -> doChat.prompt

    doChat: chat[llm=llm]()

    chatErrLog: logErrors(label="llm")
    doChat.error -> chatErrLog.messages

    encodeResponse: encode()
    doChat.response -> encodeResponse.text,data -> Self.response
}
