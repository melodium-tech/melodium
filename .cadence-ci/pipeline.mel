    testersX86_64PcWindowsGnu: buildTesters[cicd=cicd](gitlab_token=gitlab_token, target="x86_64-pc-windows-gnu", arch=|amd64(), setup=setup_x86_64_pc_windows_gnu, cargo_args="--release", profile_directory="release", repository_url=repository_url, ref=ref, gitlab_project_id=gitlab_project_id, gitlab_sha=gitlab_sha, gitlab_pipeline_id=gitlab_pipeline_id)

