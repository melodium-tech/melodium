use cicd/naive::simpleStep
use cicd/runners::CicdDispatchEngine
use process/command::|command
use std/data/string_map::StringMap
use std/data/string_map::|entry
use std/data/string_map::|map
use std/flow::one
use std/ops/option::|wrap
use std/text/compose::|format
use work/resources/arch::Arch

treatment buildTarget[cicd: CicdDispatchEngine](
    var target: string,
    var image: string,
    var arch: Arch,
    var pre_commands: string = "",
    var cargo_args: string = "",
    var environment_variables: StringMap,
    var container_cpu: u32 = 6000,
    var container_memory: u32 = 10000,
    var container_storage: u32 = 20000,
    var repository_url: string,
    var ref: string,
    var gitlab_token: string,
    var gitlab_project_id: string,
    var gitlab_sha: string,
    var gitlab_pipeline_id: string
)
  input trigger: Block<void>
  output binary: Stream<byte>
  output completed: Block<void>
  output failed: Block<void>
{
    compile: simpleStep[dispatcher=cicd](
        name=target,
        image=image,
        arch=|wrap<Arch>(arch),
        cpu=container_cpu,
        memory=container_memory,
        storage=container_storage,
        variables=|wrap<StringMap>(environment_variables),
        // `pre_commands` is a shell fragment ending in "&& " (or empty), spliced in before
        // the clone/build sequence below; `set -x` makes every command in the script (in
        // `pre_commands` too) echo to stderr as it runs.
        commands=[
            |command("sh", ["-c", |format(
                ${{set -x; {pre_commands}git config --global url."https://".insteadOf git:// && git clone --branch "{ref}" --depth 1 --shallow-submodules "{repository_url}" source && cd source && cargo build --package melodium --target {target} {cargo_args} --locked --release && mv target/{target}/release/melodium /mnt/data/melodium}},
                |map([
                    |entry("pre_commands", pre_commands),
                    |entry("ref", ref),
                    |entry("repository_url", repository_url),
                    |entry("target", target),
                    |entry("cargo_args", cargo_args)
                ])
            )])
        ],
        out_file=|wrap<string>("melodium"),
        report=true,
        gitlab=true,
        gitlab_token=gitlab_token,
        gitlab_project_id=gitlab_project_id,
        gitlab_sha=gitlab_sha,
        gitlab_ref=ref,
        gitlab_pipeline_id=gitlab_pipeline_id,
        log_service_response=true,
        description=|format("Build target {target}", |entry("target", target))
    )

    Self.trigger -> compile.trigger,data -> Self.binary
    compile.success -> Self.completed

    compileFailure: one<void>()
    compile.error  -> compileFailure.a
    compile.failed -> compileFailure.b
    compileFailure.value -> Self.failed
}
