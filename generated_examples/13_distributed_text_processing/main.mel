use std/engine/util::startup
use std/engine/log::logInfoMessage
use std/engine/log::logErrorMessage
use std/engine/log::logError
use std/engine/log::logErrors
use std/flow::emit
use std/flow::trigger
use std/data/string_map::StringMap
use std/data/string_map::|map as |string_map
use std/data/map::|map
use http/server::HttpServer
use http/server::start as startHttp
use http/server::connection
use http/method::|post
use http/status::|ok
use http/status::HttpStatus
use net/ip::|localhost_ipv4
use net/ip::|from_ipv4
use encoding::decode
use encoding::encode
use javascript::JavaScriptEngine
use javascript::process
use json::Json
use json/value::|null
use json/value::fromString
use std/ops/option::unwrapOr
use std/conv::tryToString
use work/distant::DistantEngine
use work/distant::distant
use distrib::DistributionEngine
use distrib::start
use distrib::distribute
use distrib::sendStream
use distrib::recvStream
use std/ops/option::|wrap

//
// Distributed Text Processing
//
// An HTTP server that accepts POST /process with a plain-text body and returns
// the text with every character uppercased.  The transformation runs on a
// Mélodium cloud runner provisioned on demand — no second process to start manually.
//
// Usage:
//   melodium run Compo.toml -- \
//     --api_token "my-api-token" \
//     --port 8080
//
// Test with:
//   curl -X POST http://127.0.0.1:8080/process \
//        -H "Content-Type: text/plain" \
//        -d "hello world from melodium"
//

// JavaScript engine that uppercases each received string value.
model Uppercaser() : JavaScriptEngine {
    code = "function toUpper(text) { return text.toString().toUpperCase(); }"
}

treatment main(
    const api_token: string,
    const port:      u16 = 8080
)
  model runner: DistantEngine(api_url=|wrap<string>("https://api.melodium.tech/0.1"), api_token=|wrap<string>(api_token))
  model distributor: DistributionEngine(
    treatment = "distributed_text_processing/main::processText",
    version   = "0.1.0"
  )
  model server: HttpServer(host=|from_ipv4(|localhost_ipv4()), port=port)
{
    startup()
    logStart: logInfoMessage(label="cloud", message="provisioning runner…")
    startup.trigger -> logStart.trigger

    provisionRunner: distant[distant_engine=runner](
        max_duration = 600,
        memory       = 256,
        cpu          = 500,
        storage      = 256,
        edition      = _,
        arch         = _,
        volumes      = [],
        containers   = [],
        service_containers = [],
        tags         = []
    )
    startup.trigger -> provisionRunner.trigger,access -> distribStart.access

    distantErrLog: logErrors(label="distant")
    provisionRunner.errors -> distantErrLog.messages

    distantFailLog: logErrorMessage(label="distant", message="runner provisioning failed")
    provisionRunner.failed -> distantFailLog.trigger

    distribStart: start[distributor=distributor](params=|map([]))

    distribErr: logError(label="distrib")
    distribStart.error -> distribErr.message

    logReady: logInfoMessage(label="distrib", message="runner connected")
    distribStart.ready -> logReady.trigger

    startHttp[http_server=server]()
    logServerReady: logInfoMessage(label="server", message="HTTP server ready")
    distribStart.ready -> startHttp.trigger
    distribStart.ready -> logServerReady.trigger

    connection[http_server=server](method=|post(), route="/process")

    status:      emit<HttpStatus>(value=|ok())
    headers:     emit<StringMap>(value=|string_map([]))
    bodyTrigger: trigger<byte>()

    connection.data -> bodyTrigger.stream,start --> status.trigger,emit  -> connection.status
                       bodyTrigger.start --------> headers.trigger,emit -> connection.headers

    dispatchProcess[distributor=distributor]()
    connection.data -> dispatchProcess.data,data -> connection.data
}

// Sends raw bytes to the remote processText treatment and streams results back.
treatment dispatchProcess[distributor: DistributionEngine]()
  input  data: Stream<byte>
  output data: Stream<byte>
{
    bodyTrig: trigger<byte>()
    distribute[distributor=distributor]()

    Self.data -> bodyTrig.stream,start -> distribute.trigger

    sendData: sendStream<byte>[distributor=distributor](name="data")
    recvData: recvStream<byte>[distributor=distributor](name="data")

    distribute.distribution_id -> sendData.distribution_id
    distribute.distribution_id -> recvData.distribution_id

    Self.data     -> sendData.data
    recvData.data -> Self.data
}

// The treatment executed remotely for each request.
// Receives raw UTF-8 bytes, uppercases every character via JavaScript, returns the result.
treatment processText()
  model uppercaser: Uppercaser()
  input  data: Stream<byte>
  output data: Stream<byte>
{
    decode()
    wrapStr:      fromString<string>()
    jsUpper:      process[engine=uppercaser](code="toUpper(value)")
    unwrapResult: unwrapOr<Json>(default=|null())
    resultStr:    tryToString<Json>()
    unwrapStr:    unwrapOr<string>(default="")
    encode()

    Self.data -> decode.data,text -> wrapStr.value,json -> jsUpper.value,result -> unwrapResult.option,value -> resultStr.value,into -> unwrapStr.option,value -> encode.text,data -> Self.data
}
