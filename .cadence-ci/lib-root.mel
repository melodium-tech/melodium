use cicd/runners::CicdDispatchEngine
use fs/local::writeLocal
use root/pipeline::everyPipeline
use root/pipeline::fullPipeline
use root/release::publishRelease
use std/engine/util::startup

/**
  Pipeline of every branch, see `everyPipeline`.

  `release_version` is not used, every entrypoint taking the same arguments.
*/
treatment main(
    const gitlab_token: Secret<string> = "env:MELODIUM_SECRET_GITLAB_TOKEN",
    const gitlab_project_id: string,
    const gitlab_sha: string,
    const gitlab_ref: string,
    const gitlab_pipeline_id: string,
    const repository_url: string,
    const release_version: string = "",
    const dispatch_location: string = "api"
)
  model dispatcher: CicdDispatchEngine(location=dispatch_location)
{
    startup()
    everyPipeline[cicd=dispatcher](
        gitlab_token=gitlab_token,
        repository_url=repository_url,
        ref=gitlab_ref,
        gitlab_project_id=gitlab_project_id,
        gitlab_sha=gitlab_sha,
        gitlab_pipeline_id=gitlab_pipeline_id
    )
    startup.trigger -> everyPipeline.trigger
}

/**
  Pipeline of master, see `fullPipeline`.

  The executables and testers of the targets tested on GitLab are written in `cadence/`, kept as job artifacts.
*/
treatment full(
    const gitlab_token: Secret<string> = "env:MELODIUM_SECRET_GITLAB_TOKEN",
    const gitlab_project_id: string,
    const gitlab_sha: string,
    const gitlab_ref: string,
    const gitlab_pipeline_id: string,
    const repository_url: string,
    const release_version: string,
    const dispatch_location: string = "api"
)
  model dispatcher: CicdDispatchEngine(location=dispatch_location)
{
    startup()
    fullPipeline[cicd=dispatcher](
        gitlab_token=gitlab_token,
        release_version=release_version,
        repository_url=repository_url,
        ref=gitlab_ref,
        gitlab_project_id=gitlab_project_id,
        gitlab_sha=gitlab_sha,
        gitlab_pipeline_id=gitlab_pipeline_id
    )
    startup.trigger -> fullPipeline.trigger

    writeGitlabArtifacts()
    fullPipeline.aarch64_apple_darwin ----------> writeGitlabArtifacts.aarch64_apple_darwin
    fullPipeline.aarch64_apple_darwin_testers --> writeGitlabArtifacts.aarch64_apple_darwin_testers
    fullPipeline.x86_64_pc_windows_gnu ---------> writeGitlabArtifacts.x86_64_pc_windows_gnu
    fullPipeline.x86_64_pc_windows_gnu_testers -> writeGitlabArtifacts.x86_64_pc_windows_gnu_testers
    fullPipeline.i686_pc_windows_gnu -----------> writeGitlabArtifacts.i686_pc_windows_gnu
    fullPipeline.i686_pc_windows_gnu_testers ---> writeGitlabArtifacts.i686_pc_windows_gnu_testers
}

/**
  Pipeline of release tags: `full`, then publication of the archives, installers, Debian packages,
  standard reference and package repository, see `publishRelease` for the variables they need.
*/
treatment release(
    const gitlab_token: Secret<string> = "env:MELODIUM_SECRET_GITLAB_TOKEN",
    const gitlab_project_id: string,
    const gitlab_sha: string,
    const gitlab_ref: string,
    const gitlab_pipeline_id: string,
    const repository_url: string,
    const release_version: string,
    const dispatch_location: string = "api"
)
  model dispatcher: CicdDispatchEngine(location=dispatch_location)
{
    startup()
    fullPipeline[cicd=dispatcher](
        gitlab_token=gitlab_token,
        release_version=release_version,
        repository_url=repository_url,
        ref=gitlab_ref,
        gitlab_project_id=gitlab_project_id,
        gitlab_sha=gitlab_sha,
        gitlab_pipeline_id=gitlab_pipeline_id
    )
    startup.trigger -> fullPipeline.trigger

    writeGitlabArtifacts()
    fullPipeline.aarch64_apple_darwin ----------> writeGitlabArtifacts.aarch64_apple_darwin
    fullPipeline.aarch64_apple_darwin_testers --> writeGitlabArtifacts.aarch64_apple_darwin_testers
    fullPipeline.x86_64_pc_windows_gnu ---------> writeGitlabArtifacts.x86_64_pc_windows_gnu
    fullPipeline.x86_64_pc_windows_gnu_testers -> writeGitlabArtifacts.x86_64_pc_windows_gnu_testers
    fullPipeline.i686_pc_windows_gnu -----------> writeGitlabArtifacts.i686_pc_windows_gnu
    fullPipeline.i686_pc_windows_gnu_testers ---> writeGitlabArtifacts.i686_pc_windows_gnu_testers

    publishZips: publishRelease[cicd=dispatcher](gitlab_token=gitlab_token, destination="ZIP", directory="zips", release_version=release_version, ref=gitlab_ref, gitlab_project_id=gitlab_project_id, gitlab_sha=gitlab_sha, gitlab_pipeline_id=gitlab_pipeline_id)
    publishInstallers: publishRelease[cicd=dispatcher](gitlab_token=gitlab_token, destination="INSTALLERS", directory="installers", release_version=release_version, ref=gitlab_ref, gitlab_project_id=gitlab_project_id, gitlab_sha=gitlab_sha, gitlab_pipeline_id=gitlab_pipeline_id)
    publishDeb: publishRelease[cicd=dispatcher](gitlab_token=gitlab_token, destination="DEB", directory="deb", release_version=release_version, ref=gitlab_ref, gitlab_project_id=gitlab_project_id, gitlab_sha=gitlab_sha, gitlab_pipeline_id=gitlab_pipeline_id)
    publishDoc: publishRelease[cicd=dispatcher](gitlab_token=gitlab_token, destination="DOC", directory="reference", release_version=release_version, ref=gitlab_ref, gitlab_project_id=gitlab_project_id, gitlab_sha=gitlab_sha, gitlab_pipeline_id=gitlab_pipeline_id)
    publishPackages: publishRelease[cicd=dispatcher](gitlab_token=gitlab_token, destination="PACKAGES_REPO", directory="repo", release_version=release_version, ref=gitlab_ref, gitlab_project_id=gitlab_project_id, gitlab_sha=gitlab_sha, gitlab_pipeline_id=gitlab_pipeline_id)

    fullPipeline.packages -> publishZips.archive
    fullPipeline.packages -> publishInstallers.archive
    fullPipeline.packages -> publishDeb.archive
    fullPipeline.packages_completed -> publishZips.trigger
    fullPipeline.packages_completed -> publishInstallers.trigger
    fullPipeline.packages_completed -> publishDeb.trigger

    fullPipeline.reference -----------> publishDoc.archive
    fullPipeline.reference_completed -> publishDoc.trigger

    fullPipeline.repository -----------> publishPackages.archive
    fullPipeline.repository_completed -> publishPackages.trigger
}

/**
  Writes in `cadence/` the executables and testers of the targets tested on GitLab.
*/
treatment writeGitlabArtifacts()
  input aarch64_apple_darwin: Stream<byte>
  input aarch64_apple_darwin_testers: Stream<byte>
  input x86_64_pc_windows_gnu: Stream<byte>
  input x86_64_pc_windows_gnu_testers: Stream<byte>
  input i686_pc_windows_gnu: Stream<byte>
  input i686_pc_windows_gnu_testers: Stream<byte>
{
    writeAarch64AppleDarwin: writeLocal(path="cadence/melodium-aarch64-apple-darwin", create=true)
    writeAarch64AppleDarwinTesters: writeLocal(path="cadence/testers-aarch64-apple-darwin.tar.gz", create=true)
    writeX86_64PcWindowsGnu: writeLocal(path="cadence/melodium-x86_64-pc-windows-gnu.exe", create=true)
    writeX86_64PcWindowsGnuTesters: writeLocal(path="cadence/testers-x86_64-pc-windows-gnu.tar.gz", create=true)
    writeI686PcWindowsGnu: writeLocal(path="cadence/melodium-i686-pc-windows-gnu.exe", create=true)
    writeI686PcWindowsGnuTesters: writeLocal(path="cadence/testers-i686-pc-windows-gnu.tar.gz", create=true)

    Self.aarch64_apple_darwin ----------> writeAarch64AppleDarwin.data
    Self.aarch64_apple_darwin_testers --> writeAarch64AppleDarwinTesters.data
    Self.x86_64_pc_windows_gnu ---------> writeX86_64PcWindowsGnu.data
    Self.x86_64_pc_windows_gnu_testers -> writeX86_64PcWindowsGnuTesters.data
    Self.i686_pc_windows_gnu -----------> writeI686PcWindowsGnu.data
    Self.i686_pc_windows_gnu_testers ---> writeI686PcWindowsGnuTesters.data
}
