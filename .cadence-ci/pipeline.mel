    buildPackagesRepository[cicd=cicd](gitlab_token=gitlab_token, packages=packages, repository_url=repository_url, ref=ref, gitlab_project_id=gitlab_project_id, gitlab_sha=gitlab_sha, gitlab_pipeline_id=gitlab_pipeline_id)

    Self.trigger -> checkWasm.trigger
    Self.trigger -> buildWasmPackages.trigger,archive -> buildPackagesRepository.wasm,archive -> Self.repository
    buildWasmPackages.completed -> buildPackagesRepository.trigger,completed -> Self.repository_completed
}
