#!/usr/bin/env melodium
#! name = run_caches_save
#! version = 0.1.0
#! require = std:0.11.1 fs:0.11.1 work:0.11.1

use std/engine/util::startup
use std/engine/log::logInfoMessage
use std/engine/log::logError
use std/flow::emit
use work/resources::getFileSystem
use work/cache::saveCache

// Saves `path` of the volume `data` as the cache `name`.
treatment main(const name: string, const path: string = "target")
{
    startup()

    emitVolume: emit<string>(value="data")
    getFileSystem()
    emitPath: emit<string>(value=path)
    emitName: emit<string>(value=name)
    saveCache()
    logSaved: logInfoMessage(label="cache", message="saved")
    logNotSaved: logInfoMessage(label="cache", message="not saved")
    logVolumeError: logError(label="volume")
    logSaveError: logError(label="cache")

    startup.trigger -> emitVolume.trigger,emit -> getFileSystem.name,filesystem -> saveCache.filesystem
    startup.trigger -> emitPath.trigger,emit -> saveCache.path
    startup.trigger -> emitName.trigger,emit -> saveCache.name
    getFileSystem.error -> logVolumeError.message
    saveCache.completed -> logSaved.trigger
    saveCache.failed ----> logNotSaved.trigger
    saveCache.error -----> logSaveError.message
}
