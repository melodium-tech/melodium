#!/usr/bin/env melodium
#! name = run_artifacts_push
#! version = 0.1.0
#! require = std:0.11.0 work:0.11.0

use std/engine/util::startup
use std/engine/log::logInfo
use std/engine/log::logError
use work/artifact::push

// Pushes `source` of the volume `data` as the artifact `name`.
treatment main(
    const source: string,
    const name: string,
    const access: string = "organization",
    const retention: Option<u32> = _,
    const expires: bool = true,
    const entrypoint: Option<string> = _,
    const lock: bool = false
)
{
    startup()

    pushArtifact: push(
        volume="data",
        path=source,
        name=name,
        access=access,
        retention=retention,
        expires=expires,
        entrypoint=entrypoint,
        lock=lock
    )
    logAddress: logInfo(label="address")
    logPushError: logError(label="artifact")

    startup.trigger -> pushArtifact.trigger
    pushArtifact.address -> logAddress.message
    pushArtifact.error -> logPushError.message
}
