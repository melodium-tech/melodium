#!/usr/bin/env melodium
#! name = scatter_gathering
#! version = 0.1.0
#! require = std:0.11.0

use std/engine/util::startup
use std/engine/log::logInfos
use std/engine/log::logErrors
use std/flow::emit
use std/flow::stream
use std/flow::check
use std/flow::passBlock
use std/flow/vec::flatten
use std/conv::toString
use std/ops::|not_equal
use std/flow/scatter::Scatter
use std/flow/scatter::scatterGathering
use std/flow/scatter::scattered
use std/flow/scatter::gatherValue
use std/flow/scatter::@Scattered

treatment main()
  model items: Scatter()
  model others: Scatter()
{
    startup()

    emitValues: emit<Vec<u64>>(value=[10, 20, 30, 40])
    streamValues: stream<Vec<u64>>()
    flattenValues: flatten<u64>()
    emitShared: emit<u64>(value=5)
    scatterGathering<u64, u64, u64>[scatter=items](parallel=3)
    item[items=items]()
    gatheredToString: toString<u64>()
    logGathered: logInfos(label="gathered")
    logScatter: logErrors(label="scatter")
    scatterCompleted: check<void>()
    scatterFailed: check<void>()

    startup.trigger -> emitValues.trigger,emit -> streamValues.block,stream -> flattenValues.vector,value -> scatterGathering.values
    startup.trigger -> emitShared.trigger,emit -> scatterGathering.shared
    scatterGathering.gathered -> gatheredToString.value,into -> logGathered.messages
    scatterGathering.errors ----> logScatter.messages
    scatterGathering.completed -> scatterCompleted.value
    scatterGathering.failed ----> scatterFailed.value

    // Values of another type than the scatter gathers.
    emitOthers: emit<Vec<u64>>(value=[1])
    streamOthers: stream<Vec<u64>>()
    flattenOthers: flatten<u64>()
    emitNothing: emit<void>(value=_)
    mismatched: scatterGathering<u64, void, u64>[scatter=others]()
    other[others=others]()
    logMismatched: logErrors(label="mismatched")
    mismatchedToString: toString<u64>()
    logMismatchedGathered: logInfos(label="mismatched gathered")

    startup.trigger -> emitOthers.trigger,emit -> streamOthers.block,stream -> flattenOthers.vector,value -> mismatched.values
    startup.trigger -> emitNothing.trigger,emit -> mismatched.shared
    mismatched.errors -> logMismatched.messages
    mismatched.gathered -> mismatchedToString.value,into -> logMismatchedGathered.messages
}

// Each track gathers its value, but track 2 gathers nothing; none fails.
treatment item[items: Scatter]()
  require @Scattered
{
    scattered<u64, u64>[scatter=items]()
    gatherValue<u64>[scatter=items]()
    notSilent: passBlock<u64>(cond=|not_equal<u64>(@Scattered[index], 2))
    shared: check<u64>()
    never: passBlock<u64>(cond=false)
    failed: check<u64>()
    error: emit<string>(value="never")

    scattered.value -> notSilent.block,passed -> gatherValue.value
    scattered.shared -> shared.value,check -> gatherValue.completed
    scattered.value -> never.block,passed -> failed.value,check -> gatherValue.failed
    failed.check -> error.trigger,emit -> gatherValue.error
}

// Gathers text where its scatter gathers numbers.
treatment other[others: Scatter]()
  require @Scattered
{
    scattered<u64, void>[scatter=others]()
    gatherValue<string>[scatter=others]()
    completed: check<u64>()
    text: emit<string>(value="text")
    never: passBlock<u64>(cond=false)
    failed: check<u64>()
    error: emit<string>(value="never")

    scattered.value -> completed.value,check -> gatherValue.completed
    completed.check -> text.trigger,emit -> gatherValue.value
    scattered.value -> never.block,passed -> failed.value,check -> gatherValue.failed
    failed.check -> error.trigger,emit -> gatherValue.error
}
