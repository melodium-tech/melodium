use std/engine/util::startup
use std/engine/log::logInfoMessage
use std/engine/log::logInfos
use std/engine/log::logErrorMessage
use std/engine/log::logError
use std/engine/log::logErrors
use std/flow::stream
use std/text/compose::format
use std/data/string_map::entry
use record/audio::recordMono
use ml/repos/hf::HfHub
use ml/repos/hf::fetch
use ml/models/whisper::Whisper
use ml/models/whisper::load as loadWhisper
use ml/models/whisper::decode
use ml/remote/llm::RemoteLlm
use ml/remote/llm::stream as llmStream

//
// Real-time Voice Assistant
//
// Two entrypoints:
//
//   main      : microphone → local Whisper → remote LLM (streaming tokens) → console log
//               Best for production: local STT avoids sending raw audio to a cloud.
//               melodium run Compo.toml -- --openai_key sk-...
//
//   localonly : microphone → local Whisper → local Mistral → console log (no API keys)
//               melodium run Compo.toml localonly
//               Requires ~14 GB RAM for Mistral 7B.
//
// Whisper decodes each 30-second window of audio as it arrives; the resulting
// text is immediately forwarded as a prompt to the LLM, whose tokens are printed
// to the log one by one as they stream in — no waiting for full completion.
//

model WhisperHub() : HfHub   { repo_id = "openai/whisper-tiny" }
model Asr()        : Whisper {}

model RemoteAssistant(const openai_key: string) : RemoteLlm {
    backend     = "openai"
    model       = "gpt-4o"
    system      = "You are a concise voice assistant. Answer in plain text, one short paragraph."
    max_tokens  = 256
    temperature = 0.6
}

// --- entrypoint: local Whisper + remote LLM ---

treatment main(const openai_key: string)
  model whisperHub: WhisperHub()
  model asr:        Asr()
  model llm:        RemoteAssistant(openai_key=openai_key)
{
    startup()
    fetchAsr: fetch[hub=whisperHub]()
    loadAsr:  loadWhisper[whisper=asr]()

    startup.trigger      -> fetchAsr.trigger
    fetchAsr.safetensors -> loadAsr.safetensors
    fetchAsr.tokenizer   -> loadAsr.tokenizer

    fetchFailed: logErrorMessage(label="fetch", message="Whisper fetch failed")
    fetchError:  logError(label="fetch")
    loadFailed:  logErrorMessage(label="load",  message="Whisper load failed")
    loadError:   logError(label="load")
    fetchAsr.failed -> fetchFailed.trigger
    fetchAsr.error  -> fetchError.message
    loadAsr.failed  -> loadFailed.trigger
    loadAsr.error   -> loadError.message

    logReady: logInfoMessage(label="assistant", message="ready — speak into the microphone")
    loadAsr.loaded -> logReady.trigger

    record:    recordMono(device=_, sample_rate=_)
    asrDecode: decode[whisper=asr]()

    loadAsr.loaded -> record.trigger
    loadAsr.loaded -> asrDecode.ready
    record.signal  -> asrDecode.audio

    recFailed: logErrorMessage(label="record", message="microphone error")
    recErrors: logErrors(label="record")
    record.failed -> recFailed.trigger
    record.errors -> recErrors.messages

    logQuestion: logInfos(label="you")
    asrDecode.transcribed -> logQuestion.messages

    remoteAnswer[llm=llm]()
    asrDecode.transcribed -> remoteAnswer.question

    logAnswer: logInfos(label="assistant")
    remoteAnswer.tokens -> logAnswer.messages
}

// --- entrypoint: fully local (Whisper + Mistral) ---

use ml/models/mistral::Mistral
use ml/models/mistral::load as loadMistral
use ml/models/mistral::generate

model MistralHub() : HfHub   { repo_id = "mistralai/Mistral-7B-v0.1" }
model LocalLlm()   : Mistral {
    temperature    = 0.7
    top_p          = 0.9
    max_new_tokens = 200
}

treatment localOnly()
  model whisperHub: WhisperHub()
  model mistralHub: MistralHub()
  model asr:        Asr()
  model llm:        LocalLlm()
{
    startup()
    fetchAsr: fetch[hub=whisperHub]()
    fetchLlm: fetch[hub=mistralHub]()
    loadAsr:  loadWhisper[whisper=asr]()
    loadLlm:  loadMistral[mistral=llm]()

    startup.trigger      -> fetchAsr.trigger
    startup.trigger      -> fetchLlm.trigger
    fetchAsr.safetensors -> loadAsr.safetensors
    fetchAsr.tokenizer   -> loadAsr.tokenizer
    fetchLlm.safetensors -> loadLlm.safetensors
    fetchLlm.tokenizer   -> loadLlm.tokenizer

    fetchAsrFailed: logErrorMessage(label="fetch-asr", message="Whisper fetch failed")
    fetchAsrError:  logError(label="fetch-asr")
    fetchLlmFailed: logErrorMessage(label="fetch-llm", message="Mistral fetch failed")
    fetchLlmError:  logError(label="fetch-llm")
    loadAsrFailed:  logErrorMessage(label="load-asr",  message="Whisper load failed")
    loadAsrError:   logError(label="load-asr")
    loadLlmFailed:  logErrorMessage(label="load-llm",  message="Mistral load failed")
    loadLlmError:   logError(label="load-llm")
    fetchAsr.failed -> fetchAsrFailed.trigger
    fetchAsr.error  -> fetchAsrError.message
    fetchLlm.failed -> fetchLlmFailed.trigger
    fetchLlm.error  -> fetchLlmError.message
    loadAsr.failed  -> loadAsrFailed.trigger
    loadAsr.error   -> loadAsrError.message
    loadLlm.failed  -> loadLlmFailed.trigger
    loadLlm.error   -> loadLlmError.message

    logReady: logInfoMessage(label="assistant", message="both models ready — listening…")
    loadLlm.loaded -> logReady.trigger

    record:    recordMono(device=_, sample_rate=_)
    asrDecode: decode[whisper=asr]()

    loadAsr.loaded -> record.trigger
    loadAsr.loaded -> asrDecode.ready
    record.signal  -> asrDecode.audio

    recFailed: logErrorMessage(label="record", message="microphone error")
    recErrors: logErrors(label="record")
    record.failed -> recFailed.trigger
    record.errors -> recErrors.messages

    logQuestion: logInfos(label="you")
    asrDecode.transcribed -> logQuestion.messages

    localAnswer[llm=llm]()
    asrDecode.transcribed -> localAnswer.question

    logAnswer: logInfos(label="assistant")
    localAnswer.tokens -> logAnswer.messages
}

// Remote LLM: stream tokens one by one as they arrive.
treatment remoteAnswer[llm: RemoteLlm]()
  input  question: Stream<string>
  output tokens:   Stream<string>
{
    wrapEntry: entry(key="q")
    fmt:       format(format="[Question] {q}")
    llmStream[llm=llm]()

    llmErrors: logErrors(label="llm")

    Self.question -> wrapEntry.value,map -> fmt.entries,formatted -> llmStream.prompt,token -> Self.tokens

    llmStream.error -> llmErrors.messages
}

// Local Mistral: same interface, uses generate instead of stream.
treatment localAnswer[llm: Mistral]()
  input  question: Stream<string>
  output tokens:   Stream<string>
{
    wrapEntry: entry(key="q")
    fmt:       format(format="[INST] {q} [/INST]")
    generate[mistral=llm]()

    Self.question -> wrapEntry.value,map -> fmt.entries,formatted -> generate.prompt,generated -> Self.tokens
}
