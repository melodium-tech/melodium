#!/usr/bin/env melodium
#! name = volume_filesystem
#! version = 0.1.0
#! require = std:0.11.0 fs:0.11.0 work:0.11.0

use std/engine/util::startup
use std/engine/log::logInfos
use std/engine/log::logInfoMessage
use std/engine/log::logError
use std/engine/log::logErrors
use std/flow::emit
use std/flow::stream
use std/text/convert/string::fromUtf8
use std/text/convert/string::toUtf8
use fs/file::read
use fs/file::write
use fs/dir::create
use fs/dir::scan
use work/resources::getFileSystem

// Reads `read_path`, writes `written` to `write_path`, creates `dir_path` and scans
// `scan_path`, all in the volume `data`.
treatment main(const read_path: string, const write_path: string, const dir_path: string, const scan_path: string)
{
    startup()

    emitVolume: emit<string>(value="data")
    getFileSystem()
    logVolumeError: logError(label="volume")
    startup.trigger -> emitVolume.trigger,emit -> getFileSystem.name
    getFileSystem.error -> logVolumeError.message

    emitReadPath: emit<string>(value=read_path)
    read()
    readText: fromUtf8()
    logRead: logInfos(label="read")
    logReadErrors: logErrors(label="read-error")
    startup.trigger -> emitReadPath.trigger,emit -> read.path
    getFileSystem.filesystem -> read.filesystem
    read.data -> readText.encoded,text -> logRead.messages
    read.errors -> logReadErrors.messages

    emitWritePath: emit<string>(value=write_path)
    emitContent: emit<string>(value="written")
    streamContent: stream<string>()
    contentBytes: toUtf8()
    write()
    logWritten: logInfoMessage(label="write", message="done")
    logWriteErrors: logErrors(label="write-error")
    startup.trigger -> emitWritePath.trigger,emit -> write.path
    startup.trigger -> emitContent.trigger,emit -> streamContent.block,stream -> contentBytes.text,encoded -> write.data
    getFileSystem.filesystem -> write.filesystem
    write.completed -> logWritten.trigger
    write.errors -> logWriteErrors.messages

    emitDirPath: emit<string>(value=dir_path)
    create(recursive=true)
    logCreated: logInfoMessage(label="create", message="done")
    logCreateError: logError(label="create-error")
    startup.trigger -> emitDirPath.trigger,emit -> create.path
    getFileSystem.filesystem -> create.filesystem
    create.success -> logCreated.trigger
    create.error -> logCreateError.message

    emitScanPath: emit<string>(value=scan_path)
    scan(recursive=true, follow_links=true)
    logEntries: logInfos(label="entry")
    logScanErrors: logErrors(label="scan-error")
    startup.trigger -> emitScanPath.trigger,emit -> scan.path
    getFileSystem.filesystem -> scan.filesystem
    scan.entries -> logEntries.messages
    scan.errors -> logScanErrors.messages
}
