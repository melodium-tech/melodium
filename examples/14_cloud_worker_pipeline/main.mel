use std/engine/util::startup
use std/engine/log::logInfoMessage
use std/engine/log::logErrorMessage
use std/engine/log::logError
use std/engine/log::logErrors
use std/flow::trigger
use std/data/map::|map
use std/ops/option::unwrapOr
use std/ops/option::|wrap
use std/conv::tryToString
use fs/local::readLocal
use fs/local::writeTextLocal
use work/distant::DistantEngine
use work/distant::distant
use distrib::DistributionEngine
use distrib::start
use distrib::stop
use distrib::distribute
use distrib::sendStream
use distrib::recvStream
use javascript::JavaScriptEngine
use javascript::process
use json::Json
use json/value::|null
use json/value::fromString
use encoding::decode

//
// Cloud Worker Pipeline
//
// Demonstrates provisioning an on-demand cloud runner with DistantEngine, then
// distributing a file-processing task to it.  The cloud runner executes the
// `transform` treatment: it receives raw UTF-8 file bytes, counts the words in
// each line via a JavaScript engine, and streams the word counts back as text.
//
// Architecture:
//   1. DistantEngine contacts the Mélodium Services API and provisions a runner.
//   2. Once the runner is ready, the DistributionEngine connects to it.
//   3. The local side reads the input file and sends bytes to the runner via
//      sendStream; the runner counts words per line and sends results back via
//      recvStream.
//   4. Results are written to the output file; the distributor is stopped
//      (releasing the cloud runner) after the pipeline completes.
//
// Usage:
//   melodium run Compo.toml -- \
//     --api_token "my-api-token" \
//     --input     data.txt \
//     --output    word_counts.txt
//

treatment main(
    const api_token: string,
    const input:     string,
    const output:    string = "word_counts.txt"
)
  model runner: DistantEngine(api_url=|wrap<string>("https://api-staging.melodium.tech/0.1"), api_token=|wrap<string>(api_token))
  model distributor: DistributionEngine(
    treatment = "cloud_worker_pipeline/main::transform",
    version   = "0.1.0"
  )
{
    startup()
    logStart: logInfoMessage(label="cloud", message="provisioning cloud runner…")
    startup.trigger -> logStart.trigger

    // Provision the remote container — emits Access once the runner is up.
    provisionRunner: distant[distant_engine=runner](
        max_duration = 600,
        memory       = 512,
        cpu          = 1000,
        storage      = 1024,
        edition      = _,
        arch         = _,
        volumes      = [],
        containers   = [],
        service_containers = [],
        tags         = []
    )
    startup.trigger -> provisionRunner.trigger,access -> distribStart.access

    distantErrLog:  logErrors(label="distant")
    distantFailLog: logErrorMessage(label="distant", message="runner provisioning failed")
    provisionRunner.errors -> distantErrLog.messages
    provisionRunner.failed -> distantFailLog.trigger

    // Connect the distribution engine to the freshly provisioned runner.
    distribStart: start[distributor=distributor](params=|map([]))

    logProvisioned: logInfoMessage(label="cloud", message="runner provisioned, distributor connecting…")
    distribStart.ready -> logProvisioned.trigger

    distribErr:     logError(label="distrib")
    distribFailed:  logErrorMessage(label="distrib", message="distribution engine failed")
    distribStart.error  -> distribErr.message
    distribStart.failed -> distribFailed.trigger

    // Read the local input file once the distributor is ready.
    read: readLocal(path=input)
    distribStart.ready -> read.trigger

    readFailLog:  logErrorMessage(label="read", message="input file could not be read")
    read.failed -> readFailLog.trigger

    // Dispatch the transformation to the remote runner.
    dispatch[distributor=distributor]()
    read.data -> dispatch.data,result -> write.text

    // Write the results locally.
    write: writeTextLocal(path=output)

    writeFailLog:  logErrorMessage(label="write", message="output write failed")
    write.failed -> writeFailLog.trigger

    // Stop the distributor (and release the cloud runner) after writing finishes.
    distribStop: stop[distributor=distributor]()
    write.completed -> distribStop.trigger

    logDone: logInfoMessage(label="cloud", message="pipeline complete")
    write.completed -> logDone.trigger
}

// Dispatches a byte stream to the remote transform treatment and collects results.
treatment dispatch[distributor: DistributionEngine]()
  input  data:   Stream<byte>
  output result: Stream<string>
{
    trig: trigger<byte>()
    dist: distribute[distributor=distributor]()

    Self.data -> trig.stream,start -> dist.trigger

    sendData:   sendStream<byte>[distributor=distributor](name="data")
    recvResult: recvStream<string>[distributor=distributor](name="result")

    dist.distribution_id -> sendData.distribution_id
    dist.distribution_id -> recvResult.distribution_id

    Self.data       -> sendData.data
    recvResult.data -> Self.result
}

// The treatment executed remotely.
// Receives UTF-8 text bytes, counts words per line via JavaScript, streams counts back.
model WordCounter() : JavaScriptEngine {
    code = ${{function countWords(line) {
    var s = line.trim();
    if (s.length === 0) return '0';
    return s.split(/\s+/).length.toString();
}
}}
}

treatment transform()
  model counter: WordCounter()
  input  data:   Stream<byte>
  output result: Stream<string>
{
    decode()
    wrapStr:      fromString<string>()
    jsCount:      process[engine=counter](code="countWords(value)")
    unwrapResult: unwrapOr<Json>(default=|null())
    resultStr:    tryToString<Json>()
    unwrapStr:    unwrapOr<string>(default="0")

    Self.data -> decode.data,text -> wrapStr.value,json -> jsCount.value,result -> unwrapResult.option,value -> resultStr.value,into -> unwrapStr.option,value -> Self.result
}
