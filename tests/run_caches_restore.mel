#!/usr/bin/env melodium
#! name = run_caches_restore
#! version = 0.1.0
#! require = std:0.11.0 work:0.11.0

use std/engine/util::startup
use std/engine/log::logInfo
use std/engine/log::logInfoMessage
use std/flow::emit
use work/cache::restore

// Restores into `path` of the volume `data` the first cache matching `keys`.
treatment main(const keys: Vec<string>, const path: string = "target")
{
    startup()

    emitKeys: emit<Vec<string>>(value=keys)
    restoreCache: restore(volume="data", path=path)
    logMatched: logInfo(label="matched")
    logMissed: logInfoMessage(label="cache", message="missed")

    startup.trigger -> emitKeys.trigger,emit -> restoreCache.keys
    restoreCache.matched -> logMatched.message
    restoreCache.missed -> logMissed.trigger
}
