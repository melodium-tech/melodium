    testersAarch64AppleDarwin: buildTesters[cicd=cicd](gitlab_token=gitlab_token, target="aarch64-apple-darwin", arch=|amd64(), setup=setup_aarch64_apple_darwin, repository_url=repository_url, ref=ref, gitlab_project_id=gitlab_project_id, gitlab_sha=gitlab_sha, gitlab_pipeline_id=gitlab_pipeline_id)

