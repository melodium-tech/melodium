#!/usr/bin/env melodium
#! name = secret_trait_bound
#! version = 0.10.4
#! require = std:0.10.4

use std/conv::toString

treatment leak()
  input secret: Stream<Secret<string>>
  output text: Stream<string>
{
    toString<Secret<string>>()

    Self.secret -> toString.value,into -> Self.text
}

treatment main()
{
}
